# FRED requires a personal API key. GDELT and Yahoo require no key.
# Never commit the populated .env file.
FRED_API_KEY=
OPENAI_API_KEY=
SHARADAR_API_KEY=
OPENFIGI_API_KEY=
ALPHAVANTAGE_API_KEY=
COMPANIES_HOUSE_API_KEY=

# Optional overrides. Relative paths are resolved from the project root.
STOCK_SCANNER_CACHE_DIR=data/cache/prices
STOCK_SCANNER_LOG_LEVEL=INFO

# Required before SEC EDGAR downloads. SEC asks automated clients to identify
# their organization and provide contact information.
SEC_USER_AGENT=Your Organization your.email@example.com

